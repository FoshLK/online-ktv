NODE_ENV=development
SERVER_HOST=0.0.0.0
PORT=3000
CLIENT_ORIGINS=http://localhost:1420,http://localhost:1421,http://tauri.localhost,tauri://localhost
PLAYBACK_START_LEAD_MS=3000

DATABASE_URL=postgresql://ktv:ktv_dev_password@localhost:5432/online_ktv?schema=public
REDIS_URL=redis://localhost:6379

# 默认可直接使用本机目录；后续生产环境可切换为 MinIO 驱动。
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/objects

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=ktv-dev
MINIO_SECRET_KEY=change-this-development-secret
MINIO_BUCKET=ktv-assets

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-qq-account@qq.com
SMTP_AUTH_CODE=
SMTP_FROM_NAME=线上KTV

# 仅作为桌面软件首次启动默认值；登录页和设置页可改为 EasyTier 虚拟 IP。
VITE_API_URL=http://127.0.0.1:3000/api
