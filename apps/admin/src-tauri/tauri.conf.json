{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KTV Admin",
  "version": "0.6.0",
  "identifier": "com.onlinektv.admin",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "KTV Admin", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 720, "center": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["nsis"] }
}
