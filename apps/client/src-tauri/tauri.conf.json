{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "线上 KTV",
  "version": "0.2.0",
  "identifier": "com.onlinektv.client",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "线上 KTV", "width": 1360, "height": 860, "minWidth": 1024, "minHeight": 700, "center": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["nsis"] }
}
