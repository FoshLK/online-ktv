{
  "name": "@ktv/server",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --enable-source-maps --loader ts-node/esm src/main.ts",
    "dev:pglite": "cross-env \"DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public&sslmode=disable\" SERVER_HOST=127.0.0.1 node --watch-path=src --enable-source-maps --loader ts-node/esm src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/run-tsx.cjs --test src/**/*.spec.ts",
    "db:dev": "pglite-server --db=../../data/pglite --host=127.0.0.1 --port=5432 --max-connections=20",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:deploy:pglite": "cross-env \"DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public&sslmode=disable\" prisma migrate deploy --config prisma.config.ts",
    "db:status": "prisma migrate status --config prisma.config.ts",
    "db:status:pglite": "cross-env \"DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public&sslmode=disable\" prisma migrate status --config prisma.config.ts",
    "db:seed:pglite": "cross-env \"DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public&sslmode=disable\" node ../../scripts/run-tsx.cjs src/scripts/seed-development.ts",
    "smoke:resources": "node ../../scripts/run-tsx.cjs src/scripts/smoke-resources.ts",
    "admin:promote": "node ../../scripts/run-tsx.cjs src/scripts/promote-admin.ts"
  },
  "dependencies": {
    "@ktv/contracts": "*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/platform-socket.io": "12.1.3",
    "@nestjs/websockets": "12.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.44.0",
    "class-transformer": "latest",
    "class-validator": "latest",
    "dotenv": "latest",
    "jose": "6.1.0",
    "multer": "^2.3.0",
    "nodemailer": "10.1.6",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "socket.io": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@electric-sql/pglite-socket": "^0.1.3",
    "@types/express": "latest",
    "@types/multer": "^2.0.0",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/pg": "latest",
    "prisma": "7.10.1",
    "ts-node": "^10.9.2",
    "tsx": "latest",
    "typescript": "5.9.3"
  }
}
