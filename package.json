{
  "name": "online-ktv",
  "version": "0.6.0",
  "private": true,
  "description": "线上 KTV 桌面端、管理端和服务端单仓库",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client-desktop,admin-desktop -c blue,magenta,cyan \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:admin\"",
    "dev:server": "npm run dev -w @ktv/server",
    "dev:server:pglite": "npm run dev:pglite -w @ktv/server",
    "dev:client": "npm run desktop:dev -w @ktv/client",
    "dev:admin": "npm run desktop:dev -w @ktv/admin",
    "build": "npm run build --workspaces --if-present",
    "build:desktop:client": "npm run desktop:build -w @ktv/client",
    "build:desktop:admin": "npm run desktop:build -w @ktv/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @ktv/server",
    "db:dev": "npm run db:dev -w @ktv/server",
    "db:migrate": "npm run db:migrate -w @ktv/server",
    "db:deploy": "npm run db:deploy -w @ktv/server",
    "db:deploy:pglite": "npm run db:deploy:pglite -w @ktv/server",
    "db:status": "npm run db:status -w @ktv/server",
    "db:status:pglite": "npm run db:status:pglite -w @ktv/server",
    "db:seed:pglite": "npm run db:seed:pglite -w @ktv/server",
    "admin:promote": "npm run admin:promote -w @ktv/server --",
    "easytier:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-easytier.ps1",
    "easytier:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/easytier-status.ps1",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "concurrently": "9.2.5",
    "cross-env": "^10.1.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "argon2@0.44.0": true
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  }
}
